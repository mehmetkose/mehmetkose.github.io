---
import { GITHUB_URL, SITE_TITLE, X_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<span>&copy; {year} {SITE_TITLE}</span>
	<ul class="links">
		<li><a href={GITHUB_URL} rel="me">GitHub</a></li>
		<li><a href={X_URL} rel="me">X<span class="sr-only"> (Twitter)</span></a></li>
		<li><a href="/rss.xml">RSS<span class="sr-only"> feed</span></a></li>
	</ul>
</footer>

<style>
	.site-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		margin-top: 4rem;
		padding-block: 1.5rem 3rem;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.9rem;
	}
	.links {
		display: flex;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.links a {
		/* Keeps each link at least 24×24px for touch (WCAG 2.2 target size). */
		display: inline-block;
		min-width: 24px;
		padding: 0.25rem 0.125rem;
		color: inherit;
		text-align: center;
	}
	.links a:hover {
		color: var(--text);
	}
</style>

---
import { type CollectionEntry, render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_LANG, SITE_TITLE } from '../../consts';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { breadcrumbs, ids, personRef } from '../../lib/schema';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate } = post.data;

const site = Astro.site ?? Astro.url;
const url = new URL(`/blog/${post.id}/`, site).href;
const image = `/og/blog/${post.id}.png`;
const wordCount = post.body?.split(/\s+/).filter(Boolean).length;

const schema = [
	{
		'@type': 'BlogPosting',
		'@id': `${url}#article`,
		url,
		mainEntityOfPage: url,
		headline: title,
		description,
		datePublished: pubDate.toISOString(),
		dateModified: (updatedDate ?? pubDate).toISOString(),
		image: [new URL(image, site).href],
		inLanguage: SITE_LANG,
		wordCount,
		author: personRef(site),
		publisher: { '@id': ids(site).person },
		isPartOf: { '@id': ids(site).blog },
	},
	breadcrumbs(site, [
		{ name: 'Home', path: '/' },
		{ name: 'Blog', path: '/blog/' },
		{ name: title, path: `/blog/${post.id}/` },
	]),
];
---

<Base
	title={`${title} · ${SITE_TITLE}`}
	description={description}
	type="article"
	image={image}
	imageAlt={title}
	schema={schema}
>
	<Fragment slot="head">
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		<meta property="article:author" content={site.href} />
	</Fragment>

	<article>
		<header class="post-header">
			<h1>{title}</h1>
			<p class="meta">
				By <a href="/" rel="author">{SITE_TITLE}</a> · <FormattedDate date={pubDate} />
				{
					updatedDate && (
						<>
							· Updated <FormattedDate date={updatedDate} />
						</>
					)
				}
			</p>
		</header>
		<div class="prose">
			<Content />
		</div>
	</article>

	<nav class="back" aria-label="Blog">
		<a href="/blog/"><span aria-hidden="true">←</span> All posts</a>
	</nav>
</Base>

<style>
	.post-header {
		margin-block: 2rem;
	}
	.post-header h1 {
		margin-bottom: 0.5rem;
	}
	.meta {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.meta a {
		color: inherit;
	}
	.back {
		margin-top: 3rem;
	}
</style>
